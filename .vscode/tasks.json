{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-rider-app",
      "dependsOn": [
        "Cureli rider app Tree",
        "Rider Metro Bundler",
        "Git"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "Rider Metro Bundler",
      "type": "shell",
      "command": "adb reverse tcp:8081 tcp:8081; adb reverse tcp:5000 tcp:5000; npx expo prebuild --platform android --clean; npx expo run:android",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Cureli rider app Tree",
      "type": "shell",
      "command": "ls; cd assets; tree /f; cd ..; cd src; tree /f; cd ..; cd app; tree /f; powershell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Git",
      "type": "shell",
      "command": "powershell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "new"
      }
    }
  ]
}